rules_version = '2';

// Federated scouting rules — implements the visibility model from
// docs/architecture/collaborative-scouting-model.md §4 and §5.
//
// Sprint 1.6: hardened from the placeholder rules. Now enforces:
//   - match_scouting writes carry the writer's actual orgId (from users/{uid})
//   - org create writes only by the document creator
//   - invite redemption increments use counter without rewriting other fields
//
// Sprint 1.7 — PHASE 1 READ LOCKDOWN (openness prerequisite). Reads of
// match_scouting and pit_scouting are now scoped to the reader's OWN org.
// Before this, any authed user could read every org's scouting — including
// private pit notes, which share a document with the opt-in public summary
// (Firestore rules can't field-mask, so the note rode along with the summary).
// Inviting a second org with that in place would have handed over everything
// silently. Phase 1 closes it completely by never letting one org read
// another's data. Cross-org FEDERATION (participation-gated pool + a dedicated
// public_pit_summaries collection so a shared summary can't drag notes with it)
// is Phase 2, built with the first real invite when it can be tested with two
// orgs. See docs/ESTRATEGIA-PRODUCTO-Y-APERTURA.md Parte IV.

service cloud.firestore {
    match /databases/{database}/documents {

        function isAuthed() {
            return request.auth != null;
        }

        // Org that owns pre-federation (pre-Sprint-1.4) documents. Those legacy
        // docs lack an `orgId` field; they were all written by FTC 30311, the
        // only org before federation. Mirrors DEFAULT_ORG_ID in lib/constants.
        function legacyOrgId() {
            return '30311';
        }

        function myUserDoc() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        }

        function myOrgId() {
            return myUserDoc().orgId;
        }

        function myRole() {
            return myUserDoc().role;
        }

        function isOrgAdminOrLead() {
            return myRole() == 'admin' || myRole() == 'lead';
        }

        // Users: a user reads/writes their own profile only.
        //
        // M4 hardening. `users/{uid}` is self-writable (onboarding needs it),
        // which previously let a client self-assign any orgId/role — becoming
        // admin/lead of a rival org, or inflating their own reliability weight.
        // Updates are now constrained:
        //   - role + orgId: EITHER both unchanged (normal profile edit / no-op),
        //     OR become `admin` of an org you created (verified via
        //     orgs/{orgId}.createdBy == uid). `lead` can never be self-assigned,
        //     and a client can NEVER point its own orgId at an org it didn't
        //     create — that blocks both privilege escalation AND self-joining a
        //     rival org to read its strategy (M4 vector 2).
        //   - reliability / matchesScouted: owned by the ground-truth server
        //     flow (Admin SDK, which bypasses rules); the client may never edit
        //     them, so a scout can't self-inflate their aggregation weight.
        // The legit onboarding paths still pass:
        //   - Create org → setUserOrg(admin): role scout→admin, orgId→org you
        //     just created (orgs/{id}.createdBy == uid) ✓ (second branch)
        //   - Redeem invite: joins an EXISTING (foreign) org, so it runs
        //     server-side via redeemInviteAction (Admin SDK, bypasses rules) —
        //     the client never writes this orgId itself.
        //
        // MUST be tested after `firebase deploy --only firestore:rules`: run both
        // onboarding paths (create org, redeem invite) on a dev project, and
        // confirm a direct client write of orgId→a foreign org is REJECTED.
        match /users/{uid} {
            allow read: if request.auth.uid == uid;
            allow create: if request.auth.uid == uid;
            allow update: if request.auth.uid == uid
                && (
                    (
                        request.resource.data.role == resource.data.role
                        && request.resource.data.orgId == resource.data.orgId
                    )
                    || (
                        request.resource.data.role == 'admin'
                        && request.resource.data.orgId != null
                        && exists(/databases/$(database)/documents/orgs/$(request.resource.data.orgId))
                        && get(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)).data.createdBy == request.auth.uid
                    )
                )
                && request.resource.data.reliability == resource.data.reliability
                && request.resource.data.matchesScouted == resource.data.matchesScouted;
            allow delete: if false;
        }

        // Orgs: any authed user can read (to look up team names in UI). Org
        // creation is open — the creator is recorded as createdBy. Subsequent
        // mutations require lead/admin membership of the same org.
        //
        // IMPORTANT: do NOT put sensitive fields here — Firestore rules can't
        // field-mask reads. Webhooks, API keys, etc. belong in /org_secrets.
        match /orgs/{orgId} {
            allow read: if isAuthed();
            allow create: if isAuthed()
                && request.resource.data.createdBy == request.auth.uid;
            allow update, delete: if isAuthed()
                && myOrgId() == orgId
                && isOrgAdminOrLead();
        }

        // Org secrets: admin/lead-only. Server actions use the admin SDK
        // which bypasses rules; client reads are blocked entirely so the
        // webhook URL never leaks via Firestore queries.
        match /org_secrets/{orgId} {
            allow read, write: if isAuthed()
                && myOrgId() == orgId
                && isOrgAdminOrLead();
        }

        // Invites: code lookups are public-by-auth (any authed user can read
        // by exact id) so redemption works. Listing is blocked elsewhere by
        // not exposing list queries. Creation requires lead/admin of the
        // creating org. Only the `uses` counter is updatable (the redeem path
        // increments it).
        match /org_invites/{code} {
            allow get: if isAuthed();
            allow list: if false;
            allow create: if isAuthed()
                && request.resource.data.orgId == myOrgId()
                && isOrgAdminOrLead()
                && request.resource.data.createdBy == request.auth.uid;
            allow update: if isAuthed()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']);
            allow delete: if isAuthed()
                && resource.data.orgId == myOrgId()
                && isOrgAdminOrLead();
        }

        // Event subscriptions: any authed user reads; writes require lead/admin.
        match /event_subscriptions/{subId} {
            allow read: if isAuthed();
            allow write: if isAuthed()
                && request.resource.data.orgId == myOrgId()
                && isOrgAdminOrLead();
        }

        // Match scouting (federated):
        //   - PHASE 1: reads scoped to the reader's own org. Firestore rules
        //     aren't filters — a list query must add where("orgId","==", myOrg)
        //     so every returned doc passes this rule; a query for another org's
        //     data is rejected wholesale. `resource == null` lets the
        //     create-if-not-exists existence probe (getDoc before write, see
        //     saveMatchScouting) succeed for a brand-new id. Legacy entries with
        //     no orgId are excluded from list results (the orgId filter can't
        //     match a missing field) — an accepted gap; a one-time backfill can
        //     reclaim them if any exist. Super-scouting entries live here too
        //     (scoutingMode:"super"); own-org scoping already keeps another
        //     org's subjective ratings private.
        //   - Writers must set scoutId == their uid and orgId == their actual org.
        //     This prevents impersonation across orgs.
        //   - No updates after the fact. Re-scout = new entry. Audit trail.
        match /match_scouting/{entryId} {
            allow read: if isAuthed() && (
                resource == null
                || (('orgId' in resource.data) && resource.data.orgId == myOrgId())
            );
            allow create: if isAuthed()
                && request.resource.data.scoutId == request.auth.uid
                && request.resource.data.orgId == myOrgId();
            allow update, delete: if false;
        }

        // Pit scouting: PHASE 1 — readable only by the owning org. The doc
        // holds private `notes` AND the opt-in `publicSummary` together, and
        // rules can't field-mask, so the only safe stance until Phase 2 splits
        // the public summary into its own collection is: no cross-org reads.
        //   - resource == null: getPitScouting probes the new-format id and, on
        //     miss, falls back to the legacy `${season}_${team}` id; neither
        //     probe may be denied or the fallback throws instead of returning null.
        //   - legacy branch: pre-1.4 docs have no orgId and belong to 30311, so
        //     only a 30311 reader may see them (single-doc gets; list queries
        //     filter on orgId and won't return orgId-less docs anyway).
        // Writes restricted to the doc's own org members.
        match /pit_scouting/{pitId} {
            allow read: if isAuthed() && (
                resource == null
                || (('orgId' in resource.data) && resource.data.orgId == myOrgId())
                || (!('orgId' in resource.data) && myOrgId() == legacyOrgId())
            );
            allow create: if isAuthed()
                && request.resource.data.orgId == myOrgId();
            allow update: if isAuthed()
                && resource.data.orgId == myOrgId();
            allow delete: if isAuthed()
                && resource.data.orgId == myOrgId()
                && isOrgAdminOrLead();
        }

        // Team profiles (Virtual Pit): public read, write only by the team itself.
        // The team's "owner" is the org whose teamNumber matches.
        match /team_profiles/{profileId} {
            allow read: if isAuthed();
            allow write: if isAuthed()
                && string(request.resource.data.teamNumber) == myOrgId();
        }

        // Picklists: one document per (org, event), real-time-synced for
        // collaborative alliance selection. Read/write restricted to the
        // owning org so other orgs can't snoop on each other's strategy.
        match /picklists/{picklistId} {
            allow read: if isAuthed() && resource.data.orgId == myOrgId();
            allow create: if isAuthed()
                && request.resource.data.orgId == myOrgId()
                && request.resource.data.createdBy == request.auth.uid;
            allow update: if isAuthed()
                && resource.data.orgId == myOrgId();
            allow delete: if isAuthed()
                && resource.data.orgId == myOrgId()
                && isOrgAdminOrLead();
        }

        // Calibration log: per-org. Reads/writes restricted to the owning org.
        match /calibration_log/{entryId} {
            allow read: if isAuthed()
                && resource.data.orgId == myOrgId();
            allow create: if isAuthed()
                && request.resource.data.orgId == myOrgId();
            allow update, delete: if false;
        }

        // Legacy Firestore-based api_cache. We migrated to Upstash Redis;
        // these rules block further reads/writes so the collection gets retired.
        match /api_cache/{key} {
            allow read, write: if false;
        }

        // App-level runtime config (superadmin console). Written ONLY via the
        // superadmin server action using the Admin SDK (which bypasses rules);
        // clients never touch it directly, in either direction.
        match /app_config/{doc} {
            allow read, write: if false;
        }

        // Ground-truth validation run markers — records which scouting entries
        // have already been folded into scout reliability, so a re-run stays
        // idempotent. Written ONLY by the validation runner via the Admin SDK
        // (which bypasses rules). A client that could write here could replay
        // or suppress reliability updates, so both directions stay closed.
        match /ground_truth_runs/{doc} {
            allow read, write: if false;
        }
    }
}
